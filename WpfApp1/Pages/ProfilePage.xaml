<Page x:Class="WpfApp1.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- User info -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="txtUserName" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="txtUserEmail" Margin="0,5,0,0"/>
                <TextBlock x:Name="txtUserFullName" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- My tickets -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="My tickets" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <ListBox x:Name="listBookings" Grid.Row="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="3" Padding="10" Margin="2">
                            <StackPanel>
                                <TextBlock Text="{Binding MovieTitle}" FontWeight="Bold" FontSize="14"/>
                                <WrapPanel>
                                    <TextBlock Text="Hall: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding HallName}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Date: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SessionDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <TextBlock Text="Time: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SessionTime}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Row: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SeatRow}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Seat: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SeatNumber}"/>
                                </WrapPanel>
                                <TextBlock Text="Price: " FontWeight="Bold">
                                    <Run Text="{Binding Price}"/> RUB
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Page>
