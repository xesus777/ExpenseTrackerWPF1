<Page x:Class="WpfApp1.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <ScrollViewer>
        <StackPanel Margin="10">
            <TextBlock x:Name="UserInfo" FontSize="16" Margin="0,0,0,10"/>

            <TextBlock Text="Мои отзывы" FontSize="18" FontWeight="Bold" Margin="0,10,0,5"/>
            <ItemsControl x:Name="UserReviews">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="0,5" Padding="5">
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="{Binding Books.Title}"/> ★ <Run Text="{Binding Rating}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="AuthorRequestBtn" Content="Подать заявку на роль Автора" Click="AuthorRequest_Click" Margin="0,10" Width="250" HorizontalAlignment="Left"/>

            <TextBlock x:Name="FrozenWarning" Foreground="Red" TextWrapping="Wrap" Margin="0,10" Visibility="Collapsed"/>
            <Button x:Name="AppealFrozenBtn" Content="Оспорить заморозку" Click="AppealFrozen_Click" Margin="0,5" Width="150" HorizontalAlignment="Left" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>
