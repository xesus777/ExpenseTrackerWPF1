<Page x:Class="WpfApp1.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">

    <ScrollViewer>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Margin="10">
            <Button Content="← Назад" Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>

            <TextBlock Text="Регистрация" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>

            <TextBlock Text="Логин:" Margin="5"/>
            <TextBox x:Name="LoginBox" Margin="5"/>

            <TextBlock Text="Пароль:" Margin="5"/>
            <PasswordBox x:Name="PasswordBox" Margin="5"/>

            <TextBlock Text="Подтверждение пароля:" Margin="5"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="5"/>

            <TextBlock Text="Email:" Margin="5"/>
            <TextBox x:Name="EmailBox" Margin="5"/>

            <TextBlock Text="Полное имя:" Margin="5"/>
            <TextBox x:Name="FullNameBox" Margin="5"/>

            <Button Content="Зарегистрироваться" Click="Register_Click" Margin="5" Padding="5"/>

            <TextBlock Text="Уже есть аккаунт?" HorizontalAlignment="Center" Margin="10,20,10,5"/>
            <Button Content="Войти" Click="ToLoginPage_Click" Margin="5" Padding="5"/>

            <TextBlock x:Name="MessageText" Foreground="Red" TextWrapping="Wrap" Margin="5"/>
        </StackPanel>
    </ScrollViewer>
</Page>
