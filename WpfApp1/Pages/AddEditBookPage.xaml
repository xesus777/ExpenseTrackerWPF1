<Page x:Class="WpfApp1.Pages.AddEditBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditBookPage">

    <StackPanel Margin="10" Width="400">
        <TextBlock Text="Название"/>
        <TextBox x:Name="TitleBox" Margin="5" Tag="Название" />
        <TextBlock Text="Описание"/>
        <TextBox x:Name="DescriptionBox" Margin="5" Height="60" TextWrapping="Wrap" Tag="Описание"/>
        <TextBlock Text="Путь к обложке"/>
        <TextBox x:Name="CoverPathBox" Margin="5" Tag="Путь к обложке"/>
        <TextBlock Text="Содержимое"/>
        <TextBox x:Name="ContentBox" Margin="5" Height="100" TextWrapping="Wrap" Tag="Содержимое"/>
        <TextBlock Text="Жанр"/>
        <ListBox x:Name="GenresList" Margin="5" Height="Auto" SelectionMode="Multiple" DisplayMemberPath="GenreName"/>
        <Button x:Name="SaveBtn" Content="Сохранить" Click="Save_Click" Margin="5"/>
    </StackPanel>
</Page>
