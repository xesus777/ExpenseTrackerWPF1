<Page x:Class="WpfApp1.Pages.MoviePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MoviePage">

    <ScrollViewer>
        <StackPanel Margin="10">
            <Button Content="← Назад" Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="10">
                <Image x:Name="PosterImage" Width="200" Height="250" Stretch="UniformToFill" Margin="0,0,20,0"/>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RatingText" Margin="0,5"/>
                    <TextBlock x:Name="AgeRatingText" Margin="0,5"/>
                    <TextBlock x:Name="GenresText" TextWrapping="Wrap" Margin="0,5"/>
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,5"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Сеансы:" FontSize="18" FontWeight="Bold" Margin="10,20,10,10"/>

            <ListBox x:Name="SessionsList" Margin="10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding SessionDate, StringFormat={}{0:dd.MM.yyyy}}" FontWeight="Bold"/>
                                <TextBlock Text="Время: " Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding SessionTime}"/>
                                <TextBlock Text="Зал: " Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding HallName}"/>
                                <TextBlock Text="Рейтинг зала: " Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding HallRating}"/>
                                <TextBlock Text="Цена: " Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Price}"/>
                                <Button Content="Выбрать места" Click="SelectSession_Click" Tag="{Binding SessionID}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</Page>
