<Page x:Class="WpfApp1.Pages.SavedAssembliesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      
      Title="Сохранённые сборки" >

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Сохраненные сборки" FontSize="24" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AssembliesList" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="15" CornerRadius="5" Background="LightGoldenrodYellow">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18"/>
                                        <TextBlock Text="{Binding Author}" FontSize="14" Margin="0,5"/>
                                        <TextBlock Text="{Binding PartsCount, StringFormat=Комплектующих: {0}}" Margin="0,2"/>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat=Общая стоимость: {0:C}}" FontWeight="Bold" FontSize="16" Foreground="Green" Margin="0,5"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Удалить" Background="IndianRed" Foreground="White" Padding="10,5" Margin="10" Click="DeleteAssembly_Click" Tag="{Binding Id}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Parts}" Margin="10,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="0,2">
                                                <Grid Margin="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Image Grid.Column="0" Source="{Binding image}" Width="40" Height="40" Stretch="Uniform"/>
                                                    <StackPanel Grid.Column="1" Margin="5,0">
                                                        <TextBlock Text="{Binding name}" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding parttype_.name}" FontSize="10"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding price, StringFormat={}{0:C}}" Foreground="Green" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
