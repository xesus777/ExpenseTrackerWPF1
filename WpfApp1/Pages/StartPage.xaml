<Page x:Class="WpfApp1.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StartPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Косметическую лажа" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Наши мастера и услуги" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <ListView x:Name="LvMastersServices" Grid.Row="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Мастер" Width="200" DisplayMemberBinding="{Binding MasterName}"/>
                            <GridViewColumn Header="Услуги" Width="300" DisplayMemberBinding="{Binding ServicesList}"/>
                            <GridViewColumn Header="Цена" Width="150" DisplayMemberBinding="{Binding PricesList}"/>
                            <GridViewColumn Header="Длительность" Width="100" DisplayMemberBinding="{Binding DurationList}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
