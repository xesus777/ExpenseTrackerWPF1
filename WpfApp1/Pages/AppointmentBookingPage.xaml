<Page x:Class="WpfApp1.Pages.AppointmentBookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentBookingPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="Назад" Width="60" Margin="0,0,0,20" Click="Back_Click" HorizontalAlignment="Left"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="20" 
            HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
            <StackPanel>
                <TextBlock Text="Подтверждение записи" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,10">
                    <StackPanel>
                        <TextBlock Text="Услуга:" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtService" Margin="0,5"/>

                        <TextBlock Text="Мастер:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TxtMaster" Margin="0,5"/>

                        <TextBlock Text="Дата и время:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TxtDateTime" Margin="0,5"/>

                        <TextBlock Text="Цена:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TxtPrice" Margin="0,5"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Способ оплаты" Margin="0,15,0,5"/>
                <ComboBox x:Name="CmbPaymentMethod" Height="25" Margin="0,5">
                    <ComboBoxItem Content="Наличные"/>
                    <ComboBoxItem Content="Карта"/>
                    <ComboBoxItem Content="Онлайн"/>
                </ComboBox>

                <TextBlock Text="Комментарий" Margin="0,15,0,5"/>
                <TextBox x:Name="TxtComment" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                <Button Content="Записаться" Width="120" Height="35" Margin="0,20" Click="BtnConfirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
