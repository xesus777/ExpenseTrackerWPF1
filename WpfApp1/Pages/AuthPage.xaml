<Page x:Class="WpfApp1.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <StackPanel Width="300" Margin="20">
        <TextBlock Text="Авторизация" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        <TextBlock Text="Логин"/>
        <TextBox x:Name="LoginBox" Margin="0,5" Tag="Логин"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,5" Tag="Пароль"/>
        <Button x:Name="LoginBtn" Content="Войти" Click="LoginBtn_Click" Margin="0,10"/>
        <TextBlock Text="Нет аккаунта?" Margin="0,10"/>
        <TextBlock Text="Логин"/>
        <TextBox x:Name="RegLogin" Margin="0,5" Tag="Логин"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="RegPassword" Margin="0,5" Tag="Пароль"/>
        <TextBlock Text="Почта"/>
        <TextBox x:Name="RegEmail" Margin="0,5" Tag="Email"/>
        <TextBlock Text="Отображаемое имя"/>
        <TextBox x:Name="RegDisplayName" Margin="0,5" Tag="Отображаемое имя"/>
        <Button x:Name="RegBtn" Content="Зарегистрироваться" Click="RegBtn_Click"/>
        <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,10" TextWrapping="Wrap"/>
    </StackPanel>
</Page>
