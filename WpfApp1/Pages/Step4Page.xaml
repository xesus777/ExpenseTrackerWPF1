<Page x:Class="WpfApp1.Pages.Step4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Step4Page">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <TextBlock Grid.Row="0" 
                   Text="ШАГ 4: РАСЧЕТ АВТОКРЕДИТА" 
                   FontSize="18" 
                   FontWeight="Bold"
                   Margin="20,20,20,10"/>

        
        <Grid Grid.Row="1" Margin="40,10,40,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
            <StackPanel Grid.Column="0" Margin="20,0">
                <TextBlock Text="НАСТРОЙТЕ ПАРАМЕТРЫ КРЕДИТА:" 
                           FontWeight="Bold" 
                           FontSize="16"
                           Margin="0,0,0,20"/>

                <StackPanel>
                    <TextBlock x:Name="carPriceText" 
                               Text="Стоимость автомобиля: 0 ₽" 
                               Margin="0,0,0,20"/>

                    <TextBlock x:Name="downPaymentPercentText" 
                               Text="Первоначальный взнос: 0%" 
                               FontWeight="SemiBold"/>
                    <Slider x:Name="downPaymentSlider" 
                          Minimum="10" 
                          Maximum="90" 
                          Value="20"
                          TickFrequency="5"
                          IsSnapToTickEnabled="True"
                          Margin="0,5,0,20"
                          ValueChanged="Slider_ValueChanged"/>

                    <TextBlock x:Name="loanTermText" 
                               Text="Срок кредита: 0 месяцев" 
                               FontWeight="SemiBold"/>
                    <Slider x:Name="loanTermSlider" 
                          Minimum="12" 
                          Maximum="96" 
                          Value="36"
                          TickFrequency="12"
                          IsSnapToTickEnabled="True"
                          Margin="0,5"
                          ValueChanged="Slider_ValueChanged"/>
                </StackPanel>
            </StackPanel>

            
            <Border Grid.Column="1" 
                    Background="#F8F9FA" 
                    Padding="30" 
                    Margin="20,0"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="РАСЧЕТ ПЛАТЕЖЕЙ" 
                               FontSize="20" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" 
                                  Margin="0,10">
                            <TextBlock Text="Стоимость автомобиля:" 
                                       Width="220"/>
                            <TextBlock x:Name="carPriceCalcText" 
                                       Text="0 ₽" 
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" 
                                  Margin="0,10">
                            <TextBlock Text="Первоначальный взнос:" 
                                       Width="220"/>
                            <TextBlock x:Name="downPaymentAmountText" 
                                       Text="0 ₽" 
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" 
                                  Margin="0,10">
                            <TextBlock Text="Сумма кредита:" 
                                       Width="220"/>
                            <TextBlock x:Name="loanAmountText" 
                                       Text="0 ₽" 
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" 
                                  Margin="0,10">
                            <TextBlock Text="Срок кредита:" 
                                       Width="220"/>
                            <TextBlock x:Name="loanTermCalcText" 
                                       Text="0 месяцев" 
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <Rectangle Height="2" 
                                 Fill="#2C3E50"  
                                 Margin="0,20"/>

                        <StackPanel Orientation="Horizontal" 
                                  Margin="0,15">
                            <TextBlock Text="Ежемесячный платеж:" 
                                       FontWeight="Bold" 
                                       FontSize="18"
                                       Width="220"/>
                            <TextBlock x:Name="monthlyPaymentText" 
                                       Text="0 ₽" 
                                       FontWeight="Bold" 
                                       FontSize="24"
                                       Foreground="#2C3E50"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <TextBlock Text="*Расчет ориентировочный, годовая ставка 8.5%" 
                                   FontSize="11" 
                                   Foreground="#7F8C8D"
                                   Margin="0,20,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
