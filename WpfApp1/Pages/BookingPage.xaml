<Page x:Class="WpfApp1.Pages.BookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookingPage">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Margin="10">
        <TextBlock Text="Оформление билета" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>

        <Border BorderBrush="Black" BorderThickness="1" Padding="10" Margin="5">
            <StackPanel>
                <TextBlock x:Name="MovieText" Margin="5"/>
                <TextBlock x:Name="HallText" Margin="5"/>
                <TextBlock x:Name="DateTimeText" Margin="5"/>
                <TextBlock x:Name="SeatText" Margin="5"/>
                <TextBlock x:Name="PriceText" Margin="5" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Button Content="Подтвердить бронирование" Click="ConfirmBooking_Click" Margin="5" Padding="5"/>
        <Button Content="Отмена" Click="Cancel_Click" Margin="5" Padding="5"/>
    </StackPanel>
</Page>
