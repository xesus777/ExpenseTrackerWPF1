<Page x:Class="WpfApp1.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Назад" Width="60" Click="Back_Click"/>
            <TextBlock Grid.Column="1" Text="Корзина" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Grid>

        <ListView x:Name="LvCart" Grid.Row="1" Margin="0,10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10" Width="220">
                        <StackPanel>
                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ManufacturerName}" FontSize="11" Margin="0,5"/>
                            <TextBlock Text="{Binding Price, StringFormat='{}{0:F2} руб'}" Margin="0,5"/>

                            <StackPanel Orientation="Horizontal" Margin="0,5" HorizontalAlignment="Center">
                                <Button Content="-" Width="30" Click="Decrement_Click" Tag="{Binding}"/>
                                <TextBlock Text="{Binding Quantity}" Width="40" TextAlignment="Center" FontWeight="Bold"/>
                                <Button Content="+" Width="30" Click="Increment_Click" Tag="{Binding}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding Total, StringFormat='Итого: {0:F2} руб'}" FontWeight="Bold" Margin="0,5" Foreground="Green"/>
                            <Button Content="Удалить" Margin="0,5" Click="Remove_Click" Tag="{Binding}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>

        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtTotal" FontSize="14" FontWeight="Bold"/>
                <Button Grid.Column="1" Content="Оформить заказ" Width="120" Height="30" Click="Checkout_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
