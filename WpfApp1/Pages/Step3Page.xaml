<Page x:Class="WpfApp1.Pages.Step3Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Step3Page">

    <Grid> 
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <TextBlock Grid.Row="0" 
                   Text="ШАГ 3: ИТОГОВАЯ СТОИМОСТЬ И КОНФИГУРАЦИЯ" 
                   FontSize="18" 
                   FontWeight="Bold"
                   Margin="20,20,20,10"/>

        
        <Grid Grid.Row="1" Margin="40,10,40,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
            <StackPanel Grid.Column="0" Margin="20,0">
                <TextBlock Text="ВАША КОНФИГУРАЦИЯ:" 
                           FontWeight="Bold" 
                           FontSize="16"
                           Margin="0,0,0,20"/>

                <StackPanel>
                    <TextBlock x:Name="modelText" 
                               Text="Модель: не выбрана" 
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="engineText" 
                               Text="Двигатель: не выбран"/>
                    <TextBlock x:Name="colorText" 
                               Text="Цвет: не выбран"/>

                    <TextBlock Text="Дополнительные опции:" 
                               FontWeight="SemiBold" 
                               Margin="0,10,0,5"/>

                    <StackPanel x:Name="optionsListPanel" 
                                Margin="0,0,0,10"/>
                </StackPanel>
            </StackPanel>

            
            <Border Grid.Column="1" 
                    Background="#F8F9FA" 
                    Padding="30" 
                    Margin="20,0"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="ИТОГОВАЯ СТОИМОСТЬ" 
                               FontSize="20" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" 
                                  Margin="0,5">
                            <TextBlock Text="Базовая цена модели:" 
                                       Width="200"/>
                            <TextBlock x:Name="basePriceText" 
                                       Text="0 ₽" 
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" 
                                  Margin="0,5">
                            <TextBlock Text="Двигатель:" 
                                       Width="200"/>
                            <TextBlock x:Name="enginePriceText" 
                                       Text="+0 ₽" 
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" 
                                  Margin="0,5">
                            <TextBlock Text="Цвет:" 
                                       Width="200"/>
                            <TextBlock x:Name="colorPriceText" 
                                       Text="+0 ₽" 
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" 
                                  Margin="0,5">
                            <TextBlock Text="Дополнительные опции:" 
                                       Width="200"/>
                            <TextBlock x:Name="optionsPriceText" 
                                       Text="+0 ₽" 
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <Rectangle Height="2" 
                                 Fill="#2C3E50" 
                                 Margin="0,15"/>

                        <StackPanel Orientation="Horizontal" 
                                  Margin="0,10">
                            <TextBlock Text="ИТОГО:" 
                                       FontWeight="Bold" 
                                       FontSize="18"
                                       Width="200"/>
                            <TextBlock x:Name="totalPriceText" 
                                       Text="0 ₽" 
                                       FontWeight="Bold" 
                                       FontSize="24"
                                       Foreground="#2C3E50"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
