<Page x:Class="WpfApp1.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductsPage">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" 
                Background="#2196F3" 
                Padding="15">
            <Grid>
                <TextBlock Text="Онлайн Магазин" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Button x:Name="CartButton"
                        Content="Корзина" 
                        HorizontalAlignment="Right"
                        Padding="15,8"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Click="CartButton_Click"/>
            </Grid>
        </Border>

        
        <ListBox x:Name="ProductsListBox"
                 Grid.Row="1"
                 Margin="10"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemsSource="{Binding}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E0E0E0" 
                            BorderThickness="1"
                            Background="White"
                            CornerRadius="8"
                            Margin="5"
                            Width="220"
                            Height="300">

                        <StackPanel>
                            <Border Height="140"
                                    Background="#F5F5F5"
                                    CornerRadius="8,8,0,0">
                                <Image Source="{Binding ImageUrl}"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       MaxHeight="120"/>
                            </Border>

                            
                            <StackPanel Margin="10" VerticalAlignment="Top">
                                
                                <TextBlock Text="{Binding Name}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Height="40"
                                           Margin="0,0,0,5"/>

                                
                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0:C}'}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#4CAF50"
                                           Margin="0,0,0,10"/>

                                
                                <Button Content="Добавить в корзину"
                                        Background="#2196F3"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Padding="10,6"
                                        Click="AddToCart_Click"
                                        
                                        Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"
                               HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>

</Page>
