<Page x:Class="WpfApp1.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductsPage">

    <Page.Resources>
        <Style TargetType="Border" x:Key="ProductBorder">
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasHighDiscount}" Value="True">
                    <Setter Property="Background" Value="#FFE6B3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ProductTemplate">
            <Border Style="{StaticResource ProductBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ManufacturerName}" FontSize="11" Margin="0,5"/>
                    <TextBlock Text="{Binding ProductTypeName}" FontSize="11"/>
                    <TextBlock Margin="0,5" Text="{Binding Rating, StringFormat='Рейтинг: {0:F1}'}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="Green"/>
                        <TextBlock Text=" руб" FontWeight="Bold" Foreground="Green"/>

                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Price, StringFormat={}{0:F2}}" TextDecorations="Strikethrough" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text=" руб" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock FontSize="11" Foreground="Red"
                           Text="{Binding Discount, StringFormat='Скидка: {0}%'}"
                           Visibility="{Binding HasDiscount}"/>

                    <Button Content="Подробнее" Margin="0,5" Click="ViewDetails_Click" Tag="{Binding}"/>
                    <Button Content="В корзину" Margin="0,5" Click="AddToCart_Click" Tag="{Binding}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProductDetailTemplate">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="{Binding ManufacturerName, StringFormat='Производитель: {0}'}" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="2" Text="{Binding ProductTypeName, StringFormat='Тип: {0}'}"/>
                <TextBlock Grid.Row="3" Text="{Binding Price, StringFormat='Цена без скидки: {0:F2} руб'}" Margin="0,10,0,0"/>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="Green" FontSize="14"/>
                    <TextBlock Text=" руб" FontWeight="Bold" Foreground="Green" FontSize="14"/>
                    <TextBlock Text="{Binding Discount, StringFormat=' (скидка {0}%)'}" Foreground="Red" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Text="{Binding Rating, StringFormat='Рейтинг: {0:F1}'}" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="6" Text="{Binding Description, StringFormat='Описание: {0}'}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Назад" Width="60" Click="Back_Click"/>

            <TextBox x:Name="TxtSearch" Grid.Column="1" Height="25" Margin="10,0" TextChanged="TxtSearch_TextChanged"/>

            <Button x:Name="BtnGoToCart" Grid.Column="2" Content="Корзина" Width="80" Click="BtnGoToCart_Click"/>
        </Grid>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Тип товара"/>
                    <ComboBox x:Name="CmbProductType" DisplayMemberPath="Name" SelectedValuePath="Id" 
                          SelectionChanged="CmbProductType_SelectionChanged" Height="25" Margin="0,5"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Производитель"/>
                    <ComboBox x:Name="CmbManufacturer" DisplayMemberPath="Name" SelectedValuePath="Id" 
                          SelectionChanged="CmbManufacturer_SelectionChanged" Height="25" Margin="0,5"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Сортировка по оценке"/>
                    <ComboBox x:Name="CmbSort" Height="25" Margin="0,5" SelectionChanged="CmbSort_SelectionChanged">
                        <ComboBoxItem Content="По убыванию"/>
                        <ComboBoxItem Content="По возрастанию"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="ItemsControlProducts" ItemTemplate="{StaticResource ProductTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
