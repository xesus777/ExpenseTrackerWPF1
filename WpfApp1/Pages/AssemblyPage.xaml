<Page x:Class="WpfApp1.Pages.AssemblyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AssemblyPage" >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" Grid.Row="0" Margin="5" Padding="5" TextChanged="SearchBox_TextChanged"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                <TextBlock Text="Тип:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="TypeFilter" Width="150" SelectionChanged="TypeFilter_Changed">
                    <ComboBoxItem Content="Все типы" IsSelected="True"/>
                </ComboBox>

                <TextBlock Text="Производитель:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox x:Name="ManufacturerFilter" Width="150" SelectionChanged="ManufacturerFilter_Changed">
                    <ComboBoxItem Content="Все производители" IsSelected="True"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Доступные комплектующие:" FontWeight="Bold" FontSize="14" Margin="5"/>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PartsList" Margin="5">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10" CornerRadius="5" Width="280">
                                <StackPanel>
                                    <Image Source="{Binding image}" Width="120" Height="120" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Margin="0,5"/>
                                    <TextBlock Text="{Binding manufacturer_.name}"/>
                                    <TextBlock Text="{Binding parttype_.name}"/>
                                    <TextBlock Text="{Binding price, StringFormat={}{0:C}}" FontWeight="Bold" Margin="0,5"/>
                                    <Button Content="Добавить в сборку" Padding="5" Click="AddPart_Click" Tag="{Binding id}" Margin="0,5"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Column="1" Background="LightGray">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Ваша сборка" FontWeight="Bold" FontSize="18" Margin="10" HorizontalAlignment="Center"/>

            <Button Grid.Row="1" Content="Очистить сборку" Background="IndianRed" Foreground="White" Padding="5" Margin="10" Click="ClearAssembly_Click"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SelectedPartsPanel" Margin="10">
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Background="White" Padding="15" Margin="10" CornerRadius="5">
                <TextBlock x:Name="TotalPriceText" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Row="4" Margin="10">
                <TextBlock Text="Сохранить сборку" FontWeight="Bold" FontSize="14" Margin="0,5"/>
                <TextBlock Text="Название сборки" />
                <TextBox x:Name="AssemblyName" Margin="5" Padding="5"/>
                <TextBlock Text="Автор" />
                <TextBox x:Name="AuthorName" Margin="5" Padding="5"/>
                <Button Content="Сохранить" Margin="5" Padding="10" Click="SaveAssembly_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
