<Page x:Class="WpfApp1.Pages.CheckoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CheckoutPage">

    <ScrollViewer>
        <StackPanel Margin="20">
            
            <Border Background="#FF9800" 
                    CornerRadius="5" 
                    Padding="20" 
                    Margin="0,0,0,20">
                <TextBlock Text="Оформление заказа" 
                         FontSize="24" 
                         FontWeight="Bold" 
                         Foreground="White"
                         TextAlignment="Center"/>
            </Border>

            <Border Background="White" 
                    CornerRadius="5" 
                    Padding="20" 
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Введите данные" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="ФИО:" 
                                   Width="150" 
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="FullNameTextBox" 
                                 Width="300"
                                 FontSize="14"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Почта:" 
                                   Width="150" 
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="EmailTextBox" 
                                 Width="300"
                                 FontSize="14"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Адрес:" 
                                   Width="150" 
                                   VerticalAlignment="Top"/>
                        <TextBox x:Name="AddressTextBox" 
                                 Width="300"
                                 Height="60"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="White" 
                    CornerRadius="5" 
                    Padding="20" 
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Товары в заказе" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <StackPanel x:Name="OrderItemsPanel"/>

                    <Border BorderBrush="LightGray" 
                            BorderThickness="0,1,0,0"
                            Margin="0,10,0,0">
                        <TextBlock x:Name="FinalTotalText" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center">
                <Button Content="Назад" 
                        Padding="20,10"
                        FontSize="14"
                        Click="BackButton_Click"
                        Margin="0,0,10,0"/>

                <Button Content="Заказать" 
                        Padding="20,10"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#4CAF50"
                        Foreground="White"
                        Click="OrderButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
