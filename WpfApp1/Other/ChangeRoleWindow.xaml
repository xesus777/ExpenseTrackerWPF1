<Window x:Class="WpfApp1.Other.ChangeRoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Other"
        mc:Ignorable="d"
        Title="ChangeRoleWindow" Height="450" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="15">
        <TextBlock x:Name="UserLoginText" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
        <TextBlock Text="Выберите новую роль:" Margin="0,0,0,5"/>
        <ListBox x:Name="RolesListBox" DisplayMemberPath="RoleName" Height="120" Margin="0,0,0,15"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveBtn" Content="Сохранить" Width="80" Margin="0,0,10,0" Click="SaveBtn_Click"/>
            <Button x:Name="CancelBtn" Content="Отмена" Width="80" Click="CancelBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
