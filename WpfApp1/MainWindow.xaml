<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MegaGame" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Background="LightGray" Orientation="Horizontal" >
            <TextBlock x:Name="FloorText" Text="Этаж: 1" Width="100"/>
            <TextBlock Text="Здоровье: "/>
            <ProgressBar x:Name="HealthBar" Width="200" Height="20" Minimum="0" Maximum="100" Value="100"/>
            <TextBlock x:Name="HealthText" Text="100/100"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="1" Margin="5">
            <Grid>
                <StackPanel x:Name="MainMenuPanel" Visibility="Visible" VerticalAlignment="Center">
                    <TextBlock Text="Название игры" FontSize="24" HorizontalAlignment="Center"/>
                    <Button x:Name="StartGameButton" Content="Начать игру" Width="150" Height="30" Click="StartGameButton_Click" Margin="5"/>
                </StackPanel>

                <StackPanel x:Name="GamePanel" Visibility="Collapsed" VerticalAlignment="Center">

                    <StackPanel x:Name="CombatPanel" Visibility="Collapsed">
                        <TextBlock Text="ВРАГИ" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                            <Border x:Name="Enemy1Border" BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5" Width="150">
                                <StackPanel>
                                    <Image x:Name="Enemy1Image" Width="100" Height="100" Margin="5"/>
                                    <TextBlock x:Name="Enemy1Name" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="Enemy1HealthBar" Height="15" Margin="2"/>
                                    <TextBlock x:Name="Enemy1HealthText" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock x:Name="Enemy1Ability" HorizontalAlignment="Center" FontSize="10" Foreground="Gray"/>
                                    <Button x:Name="AttackEnemy1Button" Content="Атаковать" Width="80" Height="25" 
                        Click="AttackEnemy1Button_Click" Margin="2"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="Enemy2Border" BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5" Width="150">
                                <StackPanel>
                                    <Image x:Name="Enemy2Image" Width="100" Height="100" Margin="5"/>
                                    <TextBlock x:Name="Enemy2Name" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="Enemy2HealthBar" Height="15" Margin="2"/>
                                    <TextBlock x:Name="Enemy2HealthText" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock x:Name="Enemy2Ability" HorizontalAlignment="Center" FontSize="10" Foreground="Gray"/>
                                    <Button x:Name="AttackEnemy2Button" Content="Атаковать" Width="80" Height="25" 
                        Click="AttackEnemy2Button_Click" Margin="2"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="Enemy3Border" BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5" Width="150">
                                <StackPanel>
                                    <Image x:Name="Enemy3Image" Width="100" Height="100" Margin="5"/>
                                    <TextBlock x:Name="Enemy3Name" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="Enemy3HealthBar" Height="15" Margin="2"/>
                                    <TextBlock x:Name="Enemy3HealthText" HorizontalAlignment="Center" FontSize="11"/>
                                    <TextBlock x:Name="Enemy3Ability" HorizontalAlignment="Center" FontSize="10" Foreground="Gray"/>
                                    <Button x:Name="AttackEnemy3Button" Content="Атаковать" Width="80" Height="25" 
                        Click="AttackEnemy3Button_Click" Margin="2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button x:Name="DefendButton" Content="ЗАЩИТА" Width="100" Height="30" 
            Click="DefendButton_Click" Margin="5" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="ChestPanel" Visibility="Collapsed">
                        <Image Source="Images/chest.png" Width="100" Height="100" Margin="5"/>
                        <TextBlock Text="СУНДУК" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ChestItemText" HorizontalAlignment="Center" Margin="5"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="TakeItemButton" Content="Взять" Width="80" Click="TakeItemButton_Click" Margin="2"/>
                            <Button x:Name="DropItemButton" Content="Выбросить" Width="80" Click="DropItemButton_Click" Margin="2"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="NextTurnButton" Content="Новый ход" Width="100" Height="30" Click="NextTurnButton_Click" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="GameOverPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="ВЫ ПРОИГРАЛИ!" FontSize="20" Foreground="Red" HorizontalAlignment="Center"/>
                    <Button x:Name="RestartButton" Content="Начать заново" Width="120" Click="RestartButton_Click" Margin="5" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="0" Background="LightGray" Margin="5">
            <TextBlock Text="Инвентарь" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Border BorderBrush="Black" BorderThickness="1" Width="150" Height="100" Margin="2">
                    <TextBlock x:Name="WeaponText" Text="Нет оружия" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Width="150" Height="100" Margin="2">
                    <TextBlock x:Name="ArmorText" Text="Нет брони" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Background="LightGray" Margin="5">
            <TextBlock Text="Логирование" FontWeight="Bold" HorizontalAlignment="Center"/>
            <ListBox x:Name="EventLogList" Height="100" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
