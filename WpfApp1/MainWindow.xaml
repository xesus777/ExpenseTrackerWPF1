<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MegaGame" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Background="LightGray" Orientation="Horizontal">
            <TextBlock x:Name="FloorText" Text="Этаж: 1" Width="100"/>
            <TextBlock Text="Здоровье: "/>
            <ProgressBar x:Name="HealthBar" Width="200" Height="20" Minimum="0" Maximum="100" Value="100"/>
            <TextBlock x:Name="HealthText" Text="100/100"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="1" Margin="5">
            <Grid>
                <StackPanel x:Name="MainMenuPanel" Visibility="Visible" VerticalAlignment="Center">
                    <TextBlock Text="Название игры" FontSize="24" HorizontalAlignment="Center"/>
                    <Button x:Name="StartGameButton" Content="Начать игру" Width="150" Height="30" Click="StartGameButton_Click" Margin="5"/>
                </StackPanel>

                <StackPanel x:Name="GamePanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel x:Name="CombatPanel" Visibility="Collapsed">
                        <Image x:Name="EnemyImage" Width="100" Height="100" Margin="5"/>
                        <TextBlock x:Name="EnemyNameText" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EnemyHealthText" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EnemyAbilityText" HorizontalAlignment="Center" Foreground="Gray"/>
                        <TextBlock x:Name="EnemyCountText" HorizontalAlignment="Center" Foreground="Red"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                            <Button x:Name="AttackButton" Content="Атака" Width="80" Click="AttackButton_Click" Margin="2"/>
                            <Button x:Name="DefendButton" Content="Защита" Width="80" Click="DefendButton_Click" Margin="2"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ChestPanel" Visibility="Collapsed">
                        <Image Source="Images/chest.png" Width="100" Height="100" Margin="5"/>
                        <TextBlock Text="СУНДУК" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ChestItemText" HorizontalAlignment="Center" Margin="5"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="TakeItemButton" Content="Взять" Width="80" Click="TakeItemButton_Click" Margin="2"/>
                            <Button x:Name="DropItemButton" Content="Выбросить" Width="80" Click="DropItemButton_Click" Margin="2"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="NextTurnButton" Content="Новый ход" Width="100" Height="30" Click="NextTurnButton_Click" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="GameOverPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="ВЫ ПРОИГРАЛИ!" FontSize="20" Foreground="Red" HorizontalAlignment="Center"/>
                    <Button x:Name="RestartButton" Content="Начать заново" Width="120" Click="RestartButton_Click" Margin="5" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="0" Background="LightGray" Margin="5">
            <TextBlock Text="Инвентарь" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Border BorderBrush="Black" BorderThickness="1" Width="100" Height="60" Margin="2">
                    <TextBlock x:Name="WeaponText" Text="Нет оружия" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Width="100" Height="60" Margin="2">
                    <TextBlock x:Name="ArmorText" Text="Нет брони" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Место, где показываются вещи игрока" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Background="LightGray" Margin="5">
            <TextBlock Text="Логирование" FontWeight="Bold" HorizontalAlignment="Center"/>
            <ListBox x:Name="EventLogList" Height="100" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
